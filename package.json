{
  "name": "@tree-schema/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Typed tree schema — types + graph utilities to author tree schemas (BDD example mapping and beyond). The schema itself enforces the structure of your tree.",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": ["dist", "src"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "app:dev": "pnpm -C app dev",
    "app:build": "pnpm build && pnpm -C app build"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
